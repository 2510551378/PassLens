      "changed": true,
      "status": "changed",
      "durationMs": 2.4,
      "verifier": "ok",
      "artifacts": {
        "beforePath": "artifacts/000-before.ll",
        "afterPath": "artifacts/000-after.ll"
      },
      "metricsBefore": {
        "llvm.instructions": 44,
        "llvm.basic_blocks": 6,
        "llvm.calls": 3
      },
