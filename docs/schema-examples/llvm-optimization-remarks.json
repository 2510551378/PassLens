{
  "schemaVersion": 1,
  "collectorVersion": "example-llvm-new-pass-manager/0.2.0",
  "provenance": {
    "kind": "hand-authored",
    "description": "Hand-authored LLVM New Pass Manager example including optimization-remark evidence."
  },
  "compiler": {
    "name": "opt",
