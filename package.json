{
  "name": "pass-lens",
  "displayName": "Pass Lens",
  "description": "Evidence-driven postmortem debugger for MLIR/LLVM pass pipelines.",
  "version": "0.1.0",
  "publisher": "2510551378",
  "author": "2510551378",
  "license": "MIT",
  "icon": "media/pass-lens-icon.png",
  "preview": true,
  "keywords": [
    "compiler",
    "MLIR",
    "LLVM",
    "IR",
    "debugger",
    "trace",
    "passes",
    "observability",
    "compiler-passes"
  ],
  "galleryBanner": {
    "color": "#101722",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2510551378/PassLens.git"
  },
  "bugs": {
    "url": "https://github.com/2510551378/PassLens/issues"
  },
  "homepage": "https://github.com/2510551378/PassLens#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onCommand:passLens.openTraceFile",
    "onCommand:passLens.openSampleTrace",
    "onCommand:passLens.runMlirOptTrace",
    "onCommand:passLens.runStructuredMlirTrace",
    "onCommand:passLens.checkMlirCollectorSetup",
    "onCommand:passLens.queryCurrentTrace",
    "onCommand:passLens.runPrefixBisect"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "passLens.openTraceFile",
        "title": "Pass Lens: Open Trace File"
      },
      {
        "command": "passLens.openSampleTrace",
        "title": "Pass Lens: Open Sample Trace"
      },
      {
        "command": "passLens.runMlirOptTrace",
        "title": "Pass Lens: Run mlir-opt Trace"
      },
      {
        "command": "passLens.runStructuredMlirTrace",
        "title": "Pass Lens: Run Structured MLIR Trace"
      },
      {
        "command": "passLens.checkMlirCollectorSetup",
        "title": "Pass Lens: Check MLIR Collector Setup"
      },
      {
        "command": "passLens.queryCurrentTrace",
        "title": "Pass Lens: Query Current Trace"
      },
      {
        "command": "passLens.runPrefixBisect",
        "title": "Pass Lens: Run Prefix Bisect"
      }
    ],
    "configuration": {
      "title": "Pass Lens",
      "properties": {
        "passLens.mlirOptPath": {
          "type": "string",
          "default": "mlir-opt",
          "description": "Path to the mlir-opt executable used by Pass Lens: Run mlir-opt Trace."
        },
        "passLens.mlirDriverPath": {
          "type": "string",
          "default": "pass-lens-mlir-opt",
          "description": "Path to the structured pass-lens-mlir-opt collector driver."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "passLens.openTraceFile"
        },
        {
          "command": "passLens.openSampleTrace"
        },
        {
          "command": "passLens.runMlirOptTrace"
        },
        {
          "command": "passLens.runStructuredMlirTrace"
        },
        {
          "command": "passLens.checkMlirCollectorSetup"
        },
        {
          "command": "passLens.queryCurrentTrace"
        },
        {
          "command": "passLens.runPrefixBisect"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.js",
    "validate:trace": "npm run compile && node scripts/validate-trace.js",
    "validate:trace:all": "npm run validate:trace -- --strict-only --check-artifacts sample-traces && npm run validate:trace -- --strict-only docs/schema-examples",
    "check:mlir-collector": "node scripts/check-mlir-collector.js",
    "smoke:oss-mlir": "npm run compile && node scripts/oss-mlir-corpus-smoke.js",
    "smoke:large-trace": "npm run compile && node scripts/large-trace-smoke.js",
    "smoke:heir-case-study": "npm run compile && node scripts/heir-case-study-smoke.js",
    "smoke:iree-case-study": "npm run compile && node scripts/iree-case-study-smoke.js",
    "smoke:deepseek-agent": "npm run compile && node scripts/deepseek-agent-smoke.js",
    "release:check": "node scripts/release-readiness.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.1",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.0"
  }
}
