{
  "name": "pass-lens",
  "displayName": "Pass Lens",
  "description": "Evidence-driven postmortem debugger for MLIR/LLVM pass pipelines.",
  "version": "0.1.0",
  "publisher": "2510551378",
  "author": "2510551378",
  "license": "MIT",
  "icon": "media/pass-lens-icon.png",
  "preview": true,
  "keywords": [
    "compiler",
    "MLIR",
    "LLVM",
    "IR",
    "debugger",
    "trace",
    "passes",
    "observability",
    "compiler-passes"
  ],
  "galleryBanner": {
    "color": "#101722",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2510551378/PassLens.git"
  },
  "bugs": {
    "url": "https://github.com/2510551378/PassLens/issues"
  },
  "homepage": "https://github.com/2510551378/PassLens#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onCommand:passLens.openTraceFile",
    "onCommand:passLens.openSampleTrace",
    "onCommand:passLens.runMlirOptTrace",
    "onCommand:passLens.runStructuredMlirTrace",
    "onCommand:passLens.checkMlirCollectorSetup",
    "onCommand:passLens.queryCurrentTrace",
    "onCommand:passLens.generateIssueDraft",
    "onCommand:passLens.runPrefixBisect"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "passLens.openTraceFile",
        "title": "Pass Lens: Open Trace File"
      },
      {
        "command": "passLens.openSampleTrace",
        "title": "Pass Lens: Open Sample Trace"
      },
      {
        "command": "passLens.runMlirOptTrace",
        "title": "Pass Lens: Run mlir-opt Trace"
      },
      {
        "command": "passLens.runStructuredMlirTrace",
        "title": "Pass Lens: Run Structured MLIR Trace"
      },
      {
        "command": "passLens.checkMlirCollectorSetup",
        "title": "Pass Lens: Check MLIR Collector Setup"
      },
      {
        "command": "passLens.queryCurrentTrace",
        "title": "Pass Lens: Query Current Trace"
      },
      {
        "command": "passLens.generateIssueDraft",
        "title": "Pass Lens: Generate Issue Draft"
      },
      {
        "command": "passLens.runPrefixBisect",
        "title": "Pass Lens: Run Prefix Bisect"
      }
    ],
    "configuration": {
      "title": "Pass Lens",
      "properties": {
        "passLens.mlirOptPath": {
          "type": "string",
          "default": "mlir-opt",
          "description": "Path to the mlir-opt executable used by Pass Lens: Run mlir-opt Trace."
        },
        "passLens.mlirDriverPath": {
          "type": "string",
          "default": "pass-lens-mlir-opt",
          "description": "Path to the structured pass-lens-mlir-opt collector driver."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "passLens.openTraceFile"
        },
        {
          "command": "passLens.openSampleTrace"
        },
        {
          "command": "passLens.runMlirOptTrace"
        },
        {
          "command": "passLens.runStructuredMlirTrace"
        },
        {
          "command": "passLens.checkMlirCollectorSetup"
        },
        {
          "command": "passLens.queryCurrentTrace"
        },
        {
          "command": "passLens.generateIssueDraft"
        },
        {
          "command": "passLens.runPrefixBisect"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test tests/*.test.js",
    "validate:trace": "npm run compile && node scripts/validate-trace.js",
    "validate:trace:all": "npm run validate:trace -- --strict-only --check-artifacts sample-traces && npm run validate:trace -- --strict-only docs/schema-examples",
    "check:mlir-collector": "node scripts/check-mlir-collector.js",
    "smoke:oss-mlir": "npm run compile && node scripts/oss-mlir-corpus-smoke.js",
    "smoke:large-trace": "npm run compile && node scripts/large-trace-smoke.js",
    "smoke:heir-case-study": "npm run compile && node scripts/heir-case-study-smoke.js",
    "smoke:iree-case-study": "npm run compile && node scripts/iree-case-study-smoke.js",
    "smoke:torch-mlir-case-study": "npm run compile && node scripts/torch-mlir-case-study-smoke.js",
    "smoke:downstream-case-studies": "npm run compile && node scripts/downstream-case-studies-smoke.js",
    "smoke:deepseek-agent": "npm run compile && node scripts/deepseek-agent-smoke.js",
    "release:check": "node scripts/release-readiness.js",
    "release:check:strict": "node scripts/release-readiness.js --strict-release",
    "release:smoke": "npm run validate:trace:all && npm test && npm run release:check",
    "release:preview:plan": "node scripts/release-preview-plan.js --json",
    "release:preflight": "npm run release:smoke && npm run package && npm run release:preview:plan -- --output artifacts/release-preview-plan.json",
    "release:preflight:strict": "npm run release:smoke && npm run release:check:strict && npm run package && npm run release:preview:plan -- --output artifacts/release-preview-plan.json",
    "package": "vsce package",
    "release:publish:marketplace": "node scripts/release-publish.js marketplace",
    "release:publish:marketplace:json": "node scripts/release-publish.js marketplace --dry-run --json",
    "release:publish:marketplace:execute": "node scripts/release-publish.js marketplace --execute",
    "release:publish:open-vsx": "node scripts/release-publish.js open-vsx",
    "release:publish:open-vsx:json": "node scripts/release-publish.js open-vsx --dry-run --json",
    "release:publish:open-vsx:execute": "node scripts/release-publish.js open-vsx --execute",
    "release:publish:ready": "node scripts/release-proof.js --json --require-tokens",
    "release:proof": "node scripts/release-proof.js --json",
    "vscode:prepublish": "npm run compile",
    "promote:downstream-sample": "npm run compile && node scripts/promote-downstream-trace-sample.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "ovsx": "^1.0.0",
    "typescript": "^5.9.0"
  }
}
